<Project>
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)settings\office-test-settings.json"
          Link="office-test-settings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)data\gb-samples.json"
          Link="gb-samples.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(MSBuildThisFileDirectory)data\test-catalog.json"
          Link="test-catalog.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
